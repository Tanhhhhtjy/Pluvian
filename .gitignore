# Raw observation data — never commit
radar_nc/
pwv/
stations/
era5/
2023_05-08_ERA5_PWV.nc

# Derived heavy products — regenerable
derived/

# Model checkpoints (huge, regenerable) — never commit
# Keep only the lightweight artifacts inside ckpt/ that are needed to reproduce
# tables/figures: metric JSONs, bootstrap CIs, paper figures, route summaries.
ckpt/**/*.pt
ckpt/**/*.pth
ckpt/**/*.ckpt
ckpt/**/optimizer_state.pkl
ckpt/**/scaler_state.pkl

# Debug / smoke / experimental ckpt dirs (no paper-worthy products inside)
ckpt/debug_*/
ckpt/*_smoke/
ckpt/gan_*/
ckpt/diff_*/
ckpt/latent_head_*/
ckpt/budget_residual/
ckpt/ablation_4_*/

# Archived / scratch
archive_short10ep/
tmp_*/
tmp_*.py
*.tmp.json

# Eval scratch (keep only ckpt/eval/*/metric.json, exclude raw arrays and sample previews)
ckpt/eval/**/*.npz
ckpt/eval/**/*.npy
ckpt/eval/**/sample_*.png
eval_out/
/eval/

# Logs / temp
*.log
__pycache__/
*.pyc
.ipynb_checkpoints/
logs/

# Legacy figure directories (paper figures now live under ckpt/figures/paper_*)
figures/event_test_p7c/
figures/mechanism/

# CDS credentials must never leak
.cdsapirc

# OS / IDE
.DS_Store
.vscode/
.idea/
.claude/

# Compressed source archives (originals are deleted after extraction)
*.rar
*.zip
*.tar.gz

# Backup / scratch files (should not enter history)
*.bak
*.bak.*
*.bak.csv

# Debug configs (smoke/sanity only, not used for paper results)
configs/debug_*

# Pooled bootstrap row dir is a workspace, not a result
ckpt/bootstrap_ci/_pooled_rows/
